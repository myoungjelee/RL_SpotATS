+RESUME_ITERS=6000       # 이어하기 활성 시 적용될 목표 iterations
+LOAD_RUN="$RUN_TAG"     # 불러올 이전 실험 태그
+CHECKPOINT="model_2999.pt"
+
+# ==============================================================================
+# [2] ARGUMENT ASSEMBLY (인자 조합 로직)
+# ==============================================================================
+# # 목표 반복 횟수 결정
+CURRENT_MAX_ITERS=$INITIAL_ITERS
+if [ "$RESUME" = true ]; then
+    CURRENT_MAX_ITERS=$RESUME_ITERS
+fi
+
+# # 기본 옵션 바구니
+OPTS=(
+    --task "SpotATS-Velocity-Flat-v0"
+    --experiment_name "$EXP_NAME"
+    --run_name "$RUN_TAG"
+    --seed "$SEED"
+    --max_iterations "$CURRENT_MAX_ITERS"
+    --num_envs "$NUM_ENVS"
+    --headless
+    --logger "wandb"             # 포트폴리오용 WandB 활성화
+    --log_project_name "SpotATS"
+)
+
+# # 하이드라(Hydra) 오버라이드
+HYDRA_OPTS=(
+    agent.save_interval="$SAVE_INTERVAL"
+    env.rewards.gait.weight="$GAIT_WEIGHT"
+)
+
+# # 이어하기 옵션 추가
+if [ "$RESUME" = true ]; then
+    OPTS+=(--resume --load_run "$LOAD_RUN" --checkpoint "$CHECKPOINT")
+fi
+
+# ==============================================================================
+# [3] EXECUTION (실행 및 출력)
+# ==============================================================================
+echo ">> [MODE] $( [ "$RESUME" = true ] && echo "RESUME" || echo "NEW" )"
+echo ">> Running: $EXP_NAME / $RUN_TAG (Target: $CURRENT_MAX_ITERS iters)"
 
-# --- 실행 ---
