-  --task SpotATS-Velocity-Flat-v0 \
-  --headless \
-  agent.max_iterations=1000 \
-  agent.save_interval=50 \
-  agent.experiment_name=spot_flat \
-  env.scene.num_envs=4096 \
-  hydra.run.dir="$PROJECT_ROOT/logs/rsl_rl/spot_flat"
-
