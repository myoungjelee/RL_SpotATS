# ----------------------------------------
# [direnv] PROJECT environment
# ----------------------------------------

echo "====================================================================="
echo "[direnv] $(basename "$PWD") environment"

# =========================
# 설정 (필요한 것만 채우기)
# =========================
CONDA_ENV="isaac"             # ex: isaac
ROS_DOMAIN_ID=""             # ex: 7
ROS_LOCALHOST_ONLY=""        # 기본 0
export ROS_WS=""         # ex: $PWD or $PWD/ros2_ws

# =========================
# conda
# =========================
if [[ -n "$CONDA_ENV" ]]; then
    if [[ -f "$HOME/miniconda3/etc/profile.d/conda.sh" ]]; then
        source "$HOME/miniconda3/etc/profile.d/conda.sh"
        conda activate "$CONDA_ENV"
        echo "[direnv] conda env: $CONDA_DEFAULT_ENV"
    else
        echo "[direnv] conda.sh not found: $HOME/miniconda3/etc/profile.d/conda.sh"
    fi
fi

# =========================
# ROS 환경 변수
# =========================
if [[ -n "$ROS_DOMAIN_ID" ]]; then
    export ROS_DOMAIN_ID
    export ROS_LOCALHOST_ONLY
    echo "[direnv] ROS_DOMAIN_ID: $ROS_DOMAIN_ID"
    echo "[direnv] ROS_LOCALHOST_ONLY: $ROS_LOCALHOST_ONLY"
fi

# =========================
# ROS workspace overlay
# =========================
if [[ -n "$ROS_WS" ]]; then
    if [[ -d "$ROS_WS" ]]; then
        if [[ -f "$ROS_WS/install/local_setup.bash" ]]; then
            source "$ROS_WS/install/local_setup.bash"
            echo "[direnv] ROS WS: $ROS_WS"
        else
            echo "[direnv] ROS WS found but not built: $ROS_WS"
        fi
    else
        echo "[direnv] ROS WS not found: $ROS_WS"
    fi
fi

echo "====================================================================="
